# Copy to .env and fill in what you have. Every module works with none of these
# set (mocked/stubbed fallbacks kick in and are logged loudly), but real data
# quality depends on filling these in.

# --- SEC EDGAR (required, but free/keyless) ---
# SEC requires a descriptive User-Agent identifying you on every request.
# Format: "Your Name or Org (email@example.com)"
SEC_EDGAR_USER_AGENT="Market Intel MVP (you@example.com)"

# --- News feed ---
# Finnhub free tier: https://finnhub.io/register
# If unset, NewsIngestor falls back to a MOCK news feed (clearly flagged in logs/data).
FINNHUB_API_KEY=

# --- Earnings consensus (EPS/revenue actual vs. consensus) ---
# No provider wired up yet. This MVP ships a MockEarningsProvider (flagged) behind
# the EarningsConsensusProvider interface. Ask before wiring one of:
#   - Finnhub (/stock/earnings, /calendar/earnings) — same key as FINNHUB_API_KEY
#   - Alpha Vantage (EARNINGS / EARNINGS_ESTIMATES)
#   - Zacks / IEX Cloud / other paid vendor
EARNINGS_PROVIDER=mock

# --- Macro data (FRED) ---
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# If unset, MacroIngestor falls back to a MOCK macro feed (clearly flagged).
FRED_API_KEY=

# --- Options / implied volatility ---
# No free reliable source identified for MVP. IV ingestion is a MOCK stub
# (market_reaction.iv_change always populated by MockOptionsProvider) until a
# real options data vendor (CBOE DataShop, ORATS, Polygon.io options, etc.) is wired.
OPTIONS_PROVIDER=mock

# --- Local DB ---
MARKET_INTEL_DB_PATH=./market_intel.db
